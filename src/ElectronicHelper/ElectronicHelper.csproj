<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ElectronicHelper</RootNamespace>

    <!-- The Play Store identity. The ID must never change; the version code must rise with every upload. -->
    <ApplicationId>lk.stechbuzz.electronic</ApplicationId>
    <ApplicationVersion>11</ApplicationVersion>
    <ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion>

    <!-- Play requires 64-bit code. 32-bit ARM is kept for older phones. -->
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Play accepts only app bundles. The APK is for testing the release build on a device. -->
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>

  <!--
    Release signing reads the keystore from the environment so that nothing secret is committed.
    See docs/RELEASING.md. Without these variables a release build is signed with the debug key.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(ANDROID_KEYSTORE_PATH)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(ANDROID_KEYSTORE_PATH)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:ANDROID_KEYSTORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:ANDROID_KEY_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElectronicHelper.Core\ElectronicHelper.Core.csproj" />
  </ItemGroup>

</Project>
